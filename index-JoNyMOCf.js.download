rmMessage:"Esto primero cancelará tu suscripción actual y luego iniciará una nueva suscripción",changePayMethodTitle:"Por favor cambia el método de pago",changePayMethodMessage:"Alipay no admite pedidos mayores a 3000 yuanes. Por favor usa otros métodos de pago como tarjeta bancaria o tarjeta de crédito",changePayMethodButton:"Cambiar método de pago",confirmUpgrade:"💎 Confirmar actualización",plan:"Plan",currentCycle:"Ciclo actual",totalDueToday:"Total a pagar hoy",refundNote:"* El crédito restante de tu plan actual será reembolsado por Stripe a tu método de pago original dentro de 5-10 días hábiles",afterPurchaseTitle:"Después de tu compra",afterPurchaseMessage:"Puedes gestionar las suscripciones aquí, ver facturas y configurar la información de la empresa para las facturas",openStripe:"Abrir Stripe",manageSubscription:"Gestionar suscripción"},sut={freeTrialUser:"Ahora estás en un plan de prueba exclusivo. Por favor cambia tu plan cuando termine tu período de facturación actual.",downgradeToast:"Por favor primero cambia tu plan al plan gratuito. Puedes suscribirte a otro plan cuando termine tu período de facturación actual.",upgradeSuccess:"Actualización exitosa.",downgradeSuccess:"Degradación exitosa. El cambio entrará en vigencia en el próximo período de facturación",upgradeFailed:"Actualización fallida. Verifica tu pago en Stripe.",freeSubscriptionUserToast:"Ahora estás en un plan de prueba exclusivo. Por favor cambia tu plan cuando termine tu período de facturación actual.",subscriptionDowngradeToast:"Por favor primero cambia tu plan al plan gratuito. Puedes suscribirte a otro plan cuando termine tu período de facturación actual."},lut={monthlyLimit:"Tu límite mensual",limitTip:"Este límite calcula todos los prospectos recopilados en tus proyectos",creditsRefresh:"Tus créditos se actualizarán el 1 del próximo mes.",perMonth:"créditos / mes"},cut={starter:{description:"Crea tu sitio web y haz crecer tu negocio en línea.",monthly:{projects:"10 proyectos",downloadCode:"Descargar código",removeLogo:"Eliminar logo de Readdy",exportFigma:"Exportar a Figma",collectLeads:"Recopila prospectos con 20 minutos de voz y 200 mensajes de chat",creditsPerMonth:"{credits} créditos por mes",exportAndDownload:"Exportar a Figma y descargar código",publishWithDomain:"Publicar con dominio personalizado",leadsCapture:"Captura de prospectos vía Readdy Agent {voiceLimit} minutos de voz y {chatLimit} chats por mes",formSubmissions:"50 envíos de formulario por mes"},yearly:{customDomain:"Dominio personalizado gratis por 1 año",freeDomain:"Obtén 1 dominio personalizado gratis por un año"}},pro:{description:"Desbloquea límites más altos y modelo de imagen de alta calidad para todos tus proyectos.",monthly:{everythingStarter:"Todo en Starter ",higherLimits:"Límites de IA más altos que el plan Starter",moreProjects:"Más proyectos",collectLeads:"Recopila prospectos con 80 minutos de voz y 800 mensajes de chat",creditsPerMonth:"{credits} créditos por mes",unlimitedProjects:"Proyectos ilimitados",leadsCapture:"Captura de prospectos vía Readdy Agent {voiceLimit} minutos de voz y {chatLimit} chats por mes",formSubmissions:"10,000 envíos de formulario por mes"}},pro80:{monthly:{everythingPro:"Todo en Pro-40 ",moreCredit:"Más créditos, salida extra",moreProjects:"Más proyectos"}}},uut={starter:"Para principiantes y uso ligero",pro:"Para usuarios individuales en crecimiento y proyectos secundarios",pro80:"Para proyectos con requisitos de estándares más altos.",pro120:"Para uso frecuente y proyectos en expansión",pro160:"Para negocios en escala y proyectos complejos",pro200:"Para grandes cargas de trabajo y necesidades exigentes"},dut={title:"Suscripción",upgrade:"Actualizar",undoSwitchPlan:"Deshacer cambio de plan",resetOn:"Tus créditos mensuales se reiniciarán el",switchedToFree:"Has cambiado al plan gratuito. Tu suscripción actual permanecerá activa hasta el",switchedToPlan:"Has cambiado al plan {plan}. Entrará en vigencia después de que termine tu suscripción actual el",billedInterval:"Tu cuenta se factura {interval} y el próximo pago vence el"},put={manage:"Gestionar facturación y facturas",yearly:"Anual",monthly:"Mensual",popular:"Popular",perMonth:"/ Mes",including:"Incluye",credits:"Créditos",collectLeadsWithVoiceAndChat:"Recopila prospectos con {voiceLimit} minutos de voz y {chatLimit} mensajes de chat",save:"Ahorra ${amount}",everythingInStarterPlus:"Todo en Starter, más:"},fut={domainTitle:"Disfruta de un dominio GRATIS por 1 año",domainSubtitle:"SUSCRÍBETE ANUALMENTE",subscribeTitle:"Suscríbete ahora y obtén",subscribeCredits:"1200 CRÉDITOS"},hut={monthlyCreditsLeft:"Créditos mensuales restantes",remainingTotalCredits:"Créditos restantes / totales",creditsResetOn:"Los créditos se reinician el",creditsLeft:"Créditos restantes",totalCredits:"Créditos totales",resetOn:"Reiniciar el",plan:"Plan"},mut={title:"Preguntas Frecuentes",creditsWhat:{question:"¿Qué son los créditos y cómo funcionan?",answer:"Los créditos son tu moneda de diseño en Readdy. Cada generación o edición cuesta 25 créditos. Para un desglose detallado de cómo se usan los créditos en diferentes funciones, consulta las Reglas de Consumo de Créditos.<br>Los créditos se actualizan automáticamente cada mes para todos los usuarios, ya sea que estés en un plan mensual o anual. La fecha exacta de actualización depende de la fecha de inicio de tu suscripción y se puede ver en tu página de Suscripción."},creditsRunOut:{question:"¿Qué sucede cuando me quedo sin créditos?",answer:"Cuando uses todos tus créditos disponibles, puedes actualizar a un plan de suscripción superior para recibir más. Si ya estás en el nivel más alto, contáctanos en hi{'@'}readdy.ai para opciones de créditos adicionales."},websiteAccess:{question:"¿Puede mi sitio web publicado seguir siendo accesible si cancelo mi suscripción?",answer:"No. Una vez que expire tu suscripción, tu sitio web publicado ya no será accesible en línea. Sin embargo, no te preocupes: tu proyecto permanecerá almacenado de forma segura en tu cuenta y podrás volver a publicarlo en cualquier momento después de renovar tu suscripción."},planChange:{question:"¿Puedo actualizar o bajar de categoría mi plan?",answer:"Sí, puedes actualizar o bajar de categoría tu plan en cualquier momento.<br>Las actualizaciones surten efecto de inmediato: dependiendo de tu situación, puedes pagar la diferencia de precio o el monto total del plan, y cualquier parte no utilizada de tu plan anterior se reembolsará dentro de siete días hábiles.<br>Las bajadas de categoría entran en vigencia al inicio del próximo ciclo de facturación, por lo que continuarás disfrutando de los beneficios de tu plan actual hasta entonces."},invoices:{question:"¿Proporcionan facturas?",answer:"Sí. Todas las facturas se pueden ver y descargar como archivos PDF desde tu página de Suscripción, lo que facilita el seguimiento de tus registros de facturación."},companyInvoice:{question:"¿Puedo suscribirme y obtener una factura a nombre de mi empresa?",answer:'Sí. Al realizar un pago, simplemente marca la opción "Estoy comprando como empresa" y completa los detalles de tu empresa. La factura se emitirá automáticamente a nombre de tu empresa.'}},gut={title:"¿Quieres cambiar al plan {plan} {interval}?",subtitle:"Esto es lo que cambiará si cambias",switchTo:"Cambiar a {plan}",stayOnPlan:"Mantener plan actual",feedback:{title:"¿Por qué estás cambiando de plan?",subtitle:"Ayúdanos a entender cómo podemos mejorar",selectPrompt:"Por favor selecciona todos los que apliquen:",placeholder:"Por favor especifica",budgetConsiderations:"Consideraciones de presupuesto (demasiado caro)",notEnoughValue:"No obtengo suficiente valor del plan actual",notNeedManyCredits:"No necesito tantos créditos",other:"Otro"},warning:{creditsDecrease:"El límite de créditos disminuirá de {currentCredits} a {nextCredits} por mes",projectsDecrease:"El límite de proyectos disminuirá de ilimitado a 10",voiceDecrease:"La captura de prospectos vía Readdy Voice Agent disminuirá de {currentVoiceLimit} a {nextVoiceLimit} minutos por mes",chatDecrease:"La captura de prospectos vía Readdy Chat Agent disminuirá de {currentChatLimit} a {nextChatLimit} por mes",formDecrease:"El límite de envíos de formularios disminuirá de 10,000 a 50 por mes",loseYearlyDiscount:"Perderás el 40% de descuento en facturación anual",priceChange:"El precio de suscripción mensual cambiará de ${currentPrice} a ${nextPrice}"},successMessage:"Has cambiado exitosamente al plan {planName} {interval}.<br> Tu plan actual permanecerá activo hasta {expirationDate}"},vut={manage:{title:"Gestionar suscripción",description:"Puedes cambiar al plan gratuito en cualquier momento. Tu plan actual se cancelará al final de tu ciclo de facturación.",lowerPlanDescription:"Puedes cambiar a un plan inferior que se adapte mejor a tus necesidades. El cambio entrará en vigencia después de que finalice el ciclo de facturación actual, el {expirationDate}.",switchToPlan:"Cambiar a {planName} {interval}",highestPlanDescription:"Estás en el nivel de plan más alto. No dudes en contactarnos si necesitas más créditos.",switchToFree:"Cambiar a versión gratuita",scheduledSwitch:"Has programado un cambio al plan {planName} {interval}. Entrará en vigencia en el próximo ciclo de facturación, comenzando el {expirationDate}."},tip:{title:"Gestionar suscripción",description:"Puedes cambiar al plan que mejor se adapte a tus necesidades. Tomará efecto después de que finalice el ciclo de facturación actual, el {expirationDate}.",continueButton:"Continuar para cambiar de plan",gotItButton:"Entendido"},rights:{title:"¿Estás seguro de que quieres cambiar a la versión gratuita?",subtitle:"Estás a punto de perder acceso a funciones premium",betterPrice:"Estás en un precio antiguo de mejor valor",betterPriceDesc:"Una vez degradado, se ha ido para siempre",learnMore:"Más información",websiteOffline:"Tus sitios web se desconectarán",websiteOfflineDesc:"Los clientes no podrán encontrar o visitar tu sitio",noLeads:"Ya no recibirás información de los visitantes",noLeadsDesc:"Dejarás de recibir nuevos prospectos o consultas",noExporting:"La exportación ya no estará disponible",noExportingDesc:"No podrás reutilizar tu contenido en otro lugar"},feedback:{title:"¿Podrías decirnos por qué estás cambiando a la versión gratuita?",subtitle:"Ayúdanos a entender cómo podemos mejorar",selectPrompt:"Por favor selecciona todos los que apliquen:",placeholder:"Por favor cuéntanos un poco más",helpText:"¿Algo no funciona como se esperaba? Si tienes algún problema o necesitas ayuda, estamos aquí para ti.",letsTalk:"Hablemos primero.",missingFeatures:"Falta de funciones deseadas",budgetConsiderations:"Consideraciones de presupuesto (Demasiado caro)",unsatisfied:"Insatisfecho con los resultados generados",switchedToAlternative:"Cambiado a una alternativa",technicalIssues:"Errores técnicos/problemas de uso",noNeed:"No hay necesidad inmediata",revisionsDontMeet:"Las revisiones no cumplen las expectativas",other:"Otro (por favor especifica)"},yearly:{title:"¡Espera! Ahorra hasta",discount:"40%",subtitle:"cambiando al plan anual",switchButton:"Cambiar al plan anual",noThanks:"No, gracias"},downgrade:{title:"Hablemos antes de que te vayas",subtitle:"Nos encantaría entender cómo podemos servirte mejor",chatTitle:"15 minutos de charla con Frank",earnCredits:"Gana 1200 créditos",description1:"Antes de completar la degradación, ¿estarías abierto a una charla rápida de 15 minutos con nuestro fundador, Frank?",description2:"Si programas y completas una llamada antes de degradar a la versión gratuita, recibirás 1,200 créditos de bonificación.",confirmButton:"Confirmar cambio a versión gratuita",scheduleButton:"Programar con Frank"}},but={$comment:out,plan:rut,button:iut,dialog:aut,toast:sut,credits:lut,features:cut,role:uut,header:dut,billing:put,activity:fut,remain:hut,faq:mut,downgrade:gut,toFree:vut},yut="All keys in this file are prefixed with: user.usage",wut="Uso",Aut={detail:"Detalle",credits:"Cré