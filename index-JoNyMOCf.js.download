    #ReaddyAI #效率 #生产力`},n7e={$comment:Q8e,tabs:K8e,campaign:Y8e,guidelines:W8e,submit:X8e,submitList:J8e,status:Z8e,statusInfo:_8e,error:$8e,submissionRules:e7e,templates:t7e},o7e="All keys in this file are prefixed with: activity.terms",r7e="条款和条件",i7e={title:"资格",point1:"您只能邀请以前未在 Readdy 注册过的新朋友。"},a7e={title:"奖励机制",point1:"新会员在成功注册并订阅后将获得一次性 1,200 积分奖励。",point2:"另外——邀请朋友订阅，每成功推荐一位即可获得 1,200 积分！",point3:"没有邀请限制——加入的朋友越多，您收集的积分就越多！"},s7e={title:"重要说明：",point1:"如果被邀请的朋友在其计费周期内取消订阅或降级到免费计划，双方的奖励将在订阅期结束时过期。仅未使用的积分将被没收。",point2:"在降级或取消之前请仔细考虑，因为奖励是一次性的且不可重复。",point3:"如果被邀请的朋友申请并获得退款，则该推荐的任何未使用奖励积分将自动为双方撤销。",point4:"积分消费优先级：普通积分 > 免费积分 > 即将过期的奖励积分（最快过期优先）> 奖励积分"},l7e={$comment:o7e,title:r7e,eligibility:i7e,rewards:a7e,notes:s7e},c7e="修改页面时，将复杂的需求拆分成多条简单的需求，可以获得更好的生成效果",u7e="生成页面后，可点击页面中的按钮或导航链接，继续生成下一页",d7e="点击页面中的图片和文字可直接编辑",p7e="使用selector功能 [{{shortcut}}] 选择页面上的某个元素，可以对页面进行更准确的局部修改",f7e="在首次生成时上传参考图，比在修改阶段传图效果更好",h7e="选中任意历史版本后输入修改需求，可以针对此版本进行修改",m7e="想要一次生成多个页面进行挑选？可在Account页面中设置",g7e="想生成新页面吗？可点击左侧边栏的「+ 新页面」按钮",v7e="修改页面时，将复杂的需求拆分成多条简单的需求，可以获得更好的生成效果",b7e="生成页面后，可点击页面中的按钮或导航链接，继续生成下一页",y7e="点击页面中的图片和文字可直接编辑",w7e="使用selector功能 [{{shortcut}}] 选择页面上的某个元素，可以对页面进行更准确的局部修改",A7e="在首次生成时上传参考图，比在修改阶段传图效果更好",C7e="选中任意历史版本后输入修改需求，可以针对此版本进行修改",P7e="想要一次生成多个页面进行挑选？可在Account页面中设置",S7e="想生成新页面吗？可点击左侧边栏的「+ 新页面」按钮",I7e="修改需求太多？尝试分开多条发送",x7e="想生成新页面吗？可点击左侧边栏的「+ 新页面」按钮",E7e={preview1:c7e,preview2:u7e,preview3:d7e,preview4:p7e,preview5:f7e,preview6:h7e,preview7:m7e,preview8:g7e,edit1:v7e,edit2:b7e,edit3:y7e,edit4:w7e,edit5:A7e,edit6:C7e,edit7:P7e,edit8:S7e,failed1:I7e,failed2:x7e},T7e="All keys in this file are prefixed with: auth.signin",D7e={enterEmail:"请输入邮箱地址",userNotFound:"未找到该邮箱的用户 ID",enterEmailOrClerkId:"请输入邮箱或 Clerk ID",getTokenFailed:"获取令牌失败",enterToken:"请输入令牌",signInFailed:"登录失败"},k7e={retrievedUserId:"成功获取用户 ID",tokenCopied:"令牌已成功复制到剪贴板",signInSuccess:"登录成功"},R7e={$comment:T7e,error:D7e,success:k7e},O7e="All keys in this file are prefixed with: common",B7e={confirm:"确认",c